# Required
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/velox

# JWT -- generate strong random secrets (e.g. openssl rand -base64 64)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Optional -- Redis (token blacklist, rate limiting, Socket.IO adapter)
# If not set, server still boots but blacklisting is disabled
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# AI -- LangChain + Mistral (optional, falls back to stubs if not set)
MISTRAL_API_KEY=your_mistral_api_key_here

# Widget API key HMAC secret
API_KEY_SECRET=velox-apikey-secret
